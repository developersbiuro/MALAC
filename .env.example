# ---- Server ----
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/malac
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173
# On Vercel (see vercel.json): set CLIENT_URL to your deployment domain.
# Do NOT set SERVER_URL — Vercel injects it from the client->server
# service binding declared in vercel.json.

# ---- Super Admin allowlist (the ONLY staff identity) ----
# There is NO public admin registration anywhere: public sign-up always
# creates a customer and ignores any "role" in the request. The single
# exception is this allowlist — a sign-up that verifies BOTH OTPs with
# exactly this email becomes the owner (Super Admin) account. The seed
# also creates exactly this one Super Admin, with no password (the owner
# sets it via Admin Login -> Forgot password, verified by email OTP).
# Vice-Admins are created later by the Super Admin inside the panel only.
SUPER_ADMIN_EMAIL=developersbiuro@gmail.com
SUPER_ADMIN_PHONE=+923236016684

# ---- OTP sender identity (public sender identities, NOT secrets) ----
OTP_SENDER_EMAIL=developersbiuro@gmail.com
OTP_SENDER_PHONE=+923236016684
OTP_SENDER_NAME=MALAC
# There is NO demo mode. OTP delivery is always real: if a channel's
# provider credentials below are absent, that channel fails with a clear
# "not configured" error and no code is ever shown on screen or logged.

# ---- Email OTP via SMTP / Nodemailer (required for the email channel) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- WhatsApp OTP via WhatsApp Cloud API (required for WhatsApp) ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SENDER_NUMBER=+923236016684
# Approved Meta AUTHENTICATION template used to deliver the code. Plain
# text messages only reach users inside a 24-hour service window, so
# OTPs must go out as a template (body parameter + copy-code button both
# receive the code). Create/approve the template in Meta Business Suite.
WHATSAPP_OTP_TEMPLATE=malac_otp
WHATSAPP_OTP_TEMPLATE_LANG=en

# ---- SMS OTP via Twilio (required only if the SMS channel is offered) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+923236016684

# ---- Login with Google (required for Google sign-in) ----
# The server accepts ONLY real Google ID tokens, verified against
# GOOGLE_CLIENT_ID — profile-only sign-in is always rejected. Without
# GOOGLE_CLIENT_ID, /api/auth/google returns "Google sign-in is not
# configured" and the client shows the Google button as unavailable.
# The client needs the same value at build time as VITE_GOOGLE_CLIENT_ID
# (see client/.env) — the two MUST match, or verification will fail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# ---- JazzCash / Easypaisa manual payment accounts ----
# Store accounts customers send money to. Defaults below were provided by
# the owner: the SAME account is used for both JazzCash and Easypaisa.
# Change them here or in Admin -> Settings. Empty number = method shows as
# unavailable at checkout. Do NOT reuse the OTP sender number here.
JAZZCASH_ACCOUNT_TITLE=Muhammad Abdullah
JAZZCASH_ACCOUNT_NUMBER=+923036253428
EASYPAISA_ACCOUNT_TITLE=Muhammad Abdullah
EASYPAISA_ACCOUNT_NUMBER=+923036253428
