# ---- Client (Vite) build env — copy to client/.env ----
# Google sign-in client ID. MUST match the server's GOOGLE_CLIENT_ID
# (see the root .env.example): the client uses it to request a Google ID
# token via Google Identity Services, and the server verifies that token
# against the same client ID. Empty = the Google button runs in demo mode
# (local dev only).
VITE_GOOGLE_CLIENT_ID=
